# EndoVision AI - configuration for helena (RTX 4090, 24 GB).
#
# deploy/helena/install.sh copies this file to <repo>/.env (never overwriting an
# existing .env) and sets its mode to 600. server.py loads <repo>/.env at start.
# Variables already set in the process environment take priority over this file.
#
# .env holds the password: never commit it, never print it, never paste it into
# logs, issues or chat.
#
# Comments go on their own lines. Quote values containing spaces, '#' or '$' with
# single quotes.

# --- Login (required) -------------------------------------------------------
# The app refuses to start while these are empty. Use a long random password.
APP_USER=
APP_PASSWORD=
# 1 only for throw-away local tests. Never on a machine reachable by others.
ALLOW_NO_AUTH=0
# 1 = session cookie is sent over HTTPS only (Caddy in front).
# 0 = only for testing over plain http://localhost or an SSH tunnel.
COOKIE_SECURE=1
# Hours until a login expires.
SESSION_TTL_HOURS=12
# Optional key that signs the session cookie. Unset: a random key per start, so a
# restart logs everybody out. If set, use a long random value; it is a secret.
# SESSION_SECRET=

# --- Network ----------------------------------------------------------------
# Keep 127.0.0.1. Caddy is the only thing that should talk to the app.
HOST=127.0.0.1
PORT=7860

# --- Paths (use absolute paths; leave commented to use the defaults) ---------
# MULTITASK_REPO=/home/USER/multitask-learning
# WEIGHTS_DIR=/home/USER/multitask-learning/model_weights
# HF_HOME=/home/USER/.cache/huggingface

# --- Models -----------------------------------------------------------------
CHAT_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# nf4 = 4-bit (use this on the 4090). bf16 needs about 16 GB for the LLM alone.
CHAT_QUANT=nf4
# fp16 (use this on the 4090) or fp32.
VISION_DTYPE=fp16
# Keep 0: SDXL / CogVideoX synthesis does not fit next to the other models.
ENABLE_SYNTHESIS=0

# --- Limits -----------------------------------------------------------------
# If you raise MAX_UPLOAD_MB, raise request_body max_size in the Caddyfile too.
MAX_UPLOAD_MB=50
MAX_VIDEO_SECONDS=60
OUTPUT_TTL_HOURS=24

# Testing only: emulate a smaller GPU on a bigger one. Leave unset on helena.
# SIMULATE_VRAM_GB=24
